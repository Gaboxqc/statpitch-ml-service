.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Raw downloads and caches are reproducible from source — never committed.
data/raw/
data/cache/
models/*.pkl

# Per-club Club Elo shards: a resumable fetch cache written by
# scripts/fetch_cup_club_elo.py, not a deliverable. The combined
# elo_ratings_all.parquet it produces is what gets committed.
data/processed/elo_shards/

# Secrets (API-Football key)
.env

# Machine-local editor and tool config. These were tracked by an over-broad
# `git add -A` in the first commit; they are per-developer state, not project
# state, and churn on every session.
.idea/
.claude/settings.local.json
